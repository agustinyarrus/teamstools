<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sonda de adjuntos: pega imágenes y archivos en el editor de Teams SIN mostrarlo y mide qué pasa.
       Independiente de la app (no comparte fuentes con src\) para poder probar mientras la app se edita. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>sonda-adjuntos</AssemblyName>
    <RootNamespace>SondaAdjuntos</RootNamespace>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
</Project>
